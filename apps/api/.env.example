# --- Obligatorias ---
NODE_ENV=development
# Conexión directa (o pooler en modo sesión). En local: `supabase status`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# --- Verificación de JWT ---
# Proyectos con claves asimétricas: basta SUPABASE_URL (JWKS). HS256 solo en local/legado.
SUPABASE_JWT_SECRET=
# --- Solo backend: NUNCA en el frontend ni en el repositorio ---
SUPABASE_SERVICE_ROLE_KEY=
# --- Opcionales ---
PORT=8787
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
ENFORCE_ADMIN_MFA=true
RATE_LIMIT_PER_MINUTE=300
LOG_LEVEL=info
# --- IA (Fase 3). Solo servidor: NUNCA en el frontend ni en el repositorio ---
# Sin clave, la IA queda desactivada. AI_PROVIDER=fake usa reglas de prueba sin llamadas externas (solo dev/test).
OPENAI_API_KEY=
# AI_PROVIDER=auto
# AI_MODEL_CLASSIFY=gpt-5.4-mini
# AI_MODEL_DRAFT=gpt-5.4
# AI_MODEL_SUMMARY=gpt-5.4
# --- Integraciones (Fase 4). Solo servidor: NUNCA en el frontend ni en el repositorio ---
# Claves para cifrar tokens OAuth: "kid:base64(32 bytes)". Generar con:
#   node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEYS=
# URL pública de la API (el redirect URI de OAuth es API_PUBLIC_URL/v1/oauth/google/callback)
# API_PUBLIC_URL=http://localhost:8787
# Cliente OAuth de Google Cloud (tipo «Aplicación web»). Sin él, Google aparece como no configurado.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# App de Meta (Facebook e Instagram). Redirect URI: API_PUBLIC_URL/v1/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=
# Token que eliges tú para verificar el webhook (API_PUBLIC_URL/v1/webhooks/meta; requiere https público)
META_WEBHOOK_VERIFY_TOKEN=
# META_GRAPH_VERSION=v26.0
# META_POSTS_PER_SYNC=25
