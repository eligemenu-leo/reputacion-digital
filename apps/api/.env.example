# --- Obligatorias ---
NODE_ENV=development
# Conexión directa (o pooler en modo sesión). En local: `supabase status`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# --- Verificación de JWT ---
# Proyectos con claves asimétricas: basta SUPABASE_URL (JWKS). HS256 solo en local/legado.
SUPABASE_JWT_SECRET=
# --- Solo backend: NUNCA en el frontend ni en el repositorio ---
SUPABASE_SERVICE_ROLE_KEY=
# --- Opcionales ---
PORT=8787
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
ENFORCE_ADMIN_MFA=true
RATE_LIMIT_PER_MINUTE=300
LOG_LEVEL=info
