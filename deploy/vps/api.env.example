# Copiar a api.env en el VPS (fuera de cualquier carpeta web, permisos 600) y rellenar.
# NUNCA subir api.env al repositorio.
DATABASE_URL=            # pooler de Supabase en modo SESIÓN (puerto 5432); el VPS puede no tener IPv6
SUPABASE_URL=https://msebvmmmfiryhcjntawx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=https://reputacion.eligemenu.com
CORS_ORIGINS=https://reputacion.eligemenu.com
API_PUBLIC_URL=https://api-reputacion.eligemenu.com
ENFORCE_ADMIN_MFA=true
AUTHOR_REF_PEPPER=       # nuevo, ≥ 32 caracteres aleatorios (distinto del del Mac)
CREDENTIALS_ENCRYPTION_KEYS=   # nuevo: k1:<base64 de 32 bytes> (distinto del del Mac)
OPENAI_API_KEY=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
LOG_LEVEL=info
